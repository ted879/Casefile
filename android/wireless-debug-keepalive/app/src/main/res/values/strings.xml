    <string name="permission_heading">One-time ADB permission</string>
    <string name="permission_help_missing">Connect the phone to a computer with ADB and run this once. The app cannot and does not try to grant it any other way.</string>
    <string name="permission_help_granted">Granted. To take it away again, run the revoke command.</string>
    <string name="grant_command">adb shell pm grant com.tdm.wirelessdebugkeepalive android.permission.WRITE_SECURE_SETTINGS</string>
    <string name="revoke_command">adb shell pm revoke com.tdm.wirelessdebugkeepalive android.permission.WRITE_SECURE_SETTINGS</string>

